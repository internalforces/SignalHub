{
  "name": "csv-to-signal",
  "version": "0.2.1",
  "description": "Deterministic CSV time-series signal analysis from the command line",
  "license": "Apache-2.0",
  "author": "internalforces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internalforces/SignalHub.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/internalforces/SignalHub#readme",
  "bugs": {
    "url": "https://github.com/internalforces/SignalHub/issues"
  },
  "keywords": [
    "cli",
    "csv",
    "signals",
    "sqlite",
    "time-series"
  ],
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "bin": { "csv-to-signal": "./dist/index.js" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:better-sqlite3 --outfile=dist/index.js",
    "prepack": "pnpm --filter csv-to-signal... build",
    "pretest": "pnpm --filter csv-to-signal... build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@signal-hub/analysis": "0.1.0",
    "@signal-hub/connector-csv": "0.1.0",
    "@signal-hub/core": "0.1.0",
    "@signal-hub/storage": "0.1.0",
    "@signal-hub/types": "0.1.0",
    "esbuild": "0.25.12",
    "typescript": "^5.5.4",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
